modules = ["nodejs-20", "web", "python-3.11", "postgresql-16"]
run = "npm run dev"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-24_05"
packages = ["imagemagick"]

[deployment]
deploymentTarget = "gce"
build = ["npm", "run", "build"]
run = ["npm", "run", "start"]

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 23636
externalPort = 3000

[env]
PORT = "5000"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Run tests"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "Run tests"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx vitest run"

[workflows.workflow.metadata]
outputType = "console"

[agent]
integrations = ["javascript_log_in_with_replit:1.0.0", "javascript_websocket:1.0.0", "javascript_database:1.0.0", "javascript_stripe:1.0.0", "javascript_object_storage:1.0.0", "resend:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.shared]
STRIPE_PRICE_FAMILY = "price_1TiYlGKA4XTwoahoU2tyDgbq"
STRIPE_PRICE_FAMILY_YEARLY = "price_1TiYndKA4XTwoahoFPEVYrw0"
STRIPE_PRICE_FAMILY_HERO = "price_1TiYpoKA4XTwoahob1b2c8d8"
STRIPE_PRICE_FAMILY_HERO_YEARLY = "price_1TiYqRKA4XTwoahocqpeQCqI"
STRIPE_PRICE_FAMILY_HERO_LIFETIME = "price_1TiYrLKA4XTwoahotDUjFDAo"
VITE_REVENUECAT_IOS_KEY = "appl_gzIXiKvJqKZFhpWZzgMaIMXBAJT"

[userenv.production]
APP_BASE_URL = "https://herokids.app"
EMAIL_FROM = "HeroKids <noreply@herokids.app>"

[objectStorage]
defaultBucketID = "replit-objstore-985f36e6-158d-4316-8d22-5e4228a8f037"
